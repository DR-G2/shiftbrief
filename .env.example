# Copy to .env.local and fill with values from YOUR personal Firebase web app.
# Never commit .env.local. Never put production secrets or App Check debug tokens here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Required for hosted (and recommended for local) App Check with reCAPTCHA v3
VITE_RECAPTCHA_V3_SITE_KEY=
# Optional. Only for localhost. If set to "true", the SDK prints a token to register
# in Firebase Console > App Check > Manage debug tokens. Do not ship a real token.
VITE_APPCHECK_DEBUG_TOKEN=true
