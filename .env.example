# Copy to .env.local and fill with values from YOUR personal Firebase web app.
# Never commit .env.local. Never put production secrets or App Check debug tokens here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. App Check is initialised only if this is set. Leave blank when
# App Check enforcement is off, or when a reCAPTCHA provider is not registered.
# VITE_RECAPTCHA_V3_SITE_KEY is accepted as a legacy alias.
VITE_RECAPTCHA_SITE_KEY=

# Optional. Only for localhost, and only if App Check is initialised.
# If set to "true", the SDK prints a token to register in Firebase Console
# > App Check > Manage debug tokens. Do not ship a real token.
# VITE_APPCHECK_DEBUG_TOKEN=true
